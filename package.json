{
  "name": "rust-mastery",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "One ordered Rust curriculum across TRPL, Rust by Example and Rustlings: read, see, do, recall, advance.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --outDir dist",
    "preview:subpath": "node scripts/serve-subpath.ts",
    "lint": "eslint . && prettier --check . && knip",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:content": "node scripts/check-vendored.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:content && npm run check:budget",
    "check:budget": "node scripts/check-budget.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.13.0",
    "globals": "16.5.0",
    "jsdom": "27.0.0",
    "knip": "5.71.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.57.1",
    "svelte-eslint-parser": "1.8.1",
    "svelte-check": "4.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "valibot": "^1.5.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
