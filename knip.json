{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.ts", "scripts/**/*.ts"],
  "project": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "*.config.js"
  ],
  "ignore": ["public/**", "dist/**"],
  "include": ["exports", "types", "files", "dependencies", "duplicates"],
  "svelte": true,
  "vitest": { "config": ["vitest.config.ts"] }
}
